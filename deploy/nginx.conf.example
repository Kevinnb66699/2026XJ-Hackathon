# 知适 Nginx 示例：静态文件 + /api 反代到本机 Node（server/index.mjs，只监听 127.0.0.1:8787）
# 放到 /etc/nginx/sites-available/zhishi，再软链到 sites-enabled。路径按实际部署目录改。
server {
    listen 80;
    # 域名到位后改成域名；在那之前用 _ 匹配 IP 访问
    server_name _;

    root /srv/zhishi/dist;
    index index.html;

    # 知适自己的访问日志和错误日志，单独放一个目录，由 deploy/logrotate-zhishi 每天轮转、保留 190 天：
    # 网络安全法要求网络日志留存不少于 6 个月；服务器上全局的 /var/log/nginx/*.log 只留 14 天，别的网站也在用，不改它。
    # 写在 server 块里，知适的请求就只记在这里，不再记进全局的 /var/log/nginx/access.log。
    # 目录要先建好（sudo install -d -m 755 -o root -g adm /var/log/zhishi-nginx），否则 nginx -t 不通过
    access_log /var/log/zhishi-nginx/access.log;
    error_log /var/log/zhishi-nginx/error.log;

    # 前端单页：找不到的路径都回到 index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 首页不缓存：每次都向服务器确认有没有新版本（没变时返回 304，很快）。
    # 否则微信等浏览器会按经验缓存旧首页，部署后已扫码的手机看不到更新。
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # 打包产物带哈希，可以长缓存
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # 写作检查最多等模型 8 秒、教学建议最多 20 秒，这里留余量
        proxy_read_timeout 25s;
        client_max_body_size 1m;
    }

    gzip on;
    gzip_types text/css application/javascript application/json;
}
