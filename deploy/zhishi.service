# 知适后端 systemd 示例。复制到 /etc/systemd/system/zhishi.service，按实际路径和用户修改。
[Unit]
Description=zhishi api (server/index.mjs)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/srv/zhishi
# 服务器上的 .env（chmod 600，不进仓库），里面写阿里云百炼的 Key 和业务空间专属域名（末尾不要 /）：
#   LLM_API_KEY="..."
#   LLM_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 可选：LLM_MODEL=...、PIPELINE_MODEL=...（手动换模型，见 deploy/README.md）、PORT=8787、DATA_DIR=...
EnvironmentFile=/srv/zhishi/.env
Environment=NODE_ENV=production
# Node 20 的路径以 `which node` 为准
ExecStart=/usr/bin/node server/index.mjs
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
